# Client SPA environment configuration (baked into build by Vite)
#
# Same-domain (reverse proxy) deployment defaults:
VITE_API_BASE_URL=/api/v1
VITE_MEDIA_BASE_URL=/api/media

# Optional explicit Auth base URL (defaults to ${VITE_API_BASE_URL}/auth)
# VITE_AUTH_BASE_URL=/api/v1/auth

# Cross-domain / subpath examples:
# VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_MEDIA_BASE_URL=https://cdn.example.com/media
# VITE_API_BASE_URL=https://shop.example.com/billing/api/v1
# VITE_MEDIA_BASE_URL=https://shop.example.com/media-service

# Vite dev proxy targets (used only during `npm run dev`):
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
# VITE_DEV_MEDIA_TARGET=http://127.0.0.1:8001
